# =============================================
# FixItNow Backend — Environment Variables
# Copy this file to .env and fill in values
# =============================================

# Server
PORT=5001
NODE_ENV=development                     # development | production
BACKEND_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgres://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/fixitnow

# JWT
JWT_SECRET=your_jwt_access_secret_here
JWT_EXPIRES_IN=1d

JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# Stripe Webhook Secret
# Get from https://dashboard.stripe.com/webhooks OR run: stripe listen --print-secret
STRIPE_WEBHOOK_SECRET=whsec_...
